rules_version = '2';

// Reglas de seguridad de "Rutas de Bolivia".
// Se pegan en: consola de Firebase > Firestore Database > Reglas > Publicar.
//
// Idea general:
//   - El catálogo (destinos, departamentos, eventos...) lo lee cualquiera y
//     solo lo modifica un administrador.
//   - Los datos personales (usuarios, favoritos, preferencias) solo los ve y
//     modifica su dueño.
//   - Un administrador es quien tiene un documento en "administradores" cuyo
//     ID es su correo electrónico.
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null;
    }

    function esAdmin() {
      return conSesion()
        && exists(/databases/$(database)/documents/administradores/$(request.auth.token.email));
    }

    // ---------- Catálogo público ----------
    match /destinos/{id}      { allow read: if true; allow write: if esAdmin(); }
    match /categorias/{id}    { allow read: if true; allow write: if esAdmin(); }
    match /departamentos/{id} { allow read: if true; allow write: if esAdmin(); }
    match /municipios/{id}    { allow read: if true; allow write: if esAdmin(); }
    match /regiones/{id}      { allow read: if true; allow write: if esAdmin(); }
    match /actividades/{id}   { allow read: if true; allow write: if esAdmin(); }
    match /eventos/{id}       { allow read: if true; allow write: if esAdmin(); }
    match /platos/{id}        { allow read: if true; allow write: if esAdmin(); }
    match /restaurantes/{id}  { allow read: if true; allow write: if esAdmin(); }
    match /alojamientos/{id}  { allow read: if true; allow write: if esAdmin(); }

    // ---------- Reseñas ----------
    // La colección se llama "reseñas". Se detecta con una expresión regular
    // para no escribir la "ñ" en la ruta de la regla.
    match /{coleccion}/{id} {
      allow read: if coleccion.matches('rese.as');
      // Cada persona publica reseñas solo a su nombre, con 1 a 5 estrellas.
      allow create: if coleccion.matches('rese.as')
        && conSesion()
        && request.resource.data.id_usuario == request.auth.uid
        && request.resource.data.calificacion is number
        && request.resource.data.calificacion >= 1
        && request.resource.data.calificacion <= 5
        && request.resource.data.comentario is string
        && request.resource.data.comentario.size() <= 1000
        && request.resource.data.estado == 'publicada';
      // Ocultar, publicar o eliminar es tarea de moderación.
      allow update, delete: if coleccion.matches('rese.as') && esAdmin();
    }

    // ---------- Datos personales ----------
    match /usuarios/{uid} {
      allow get: if conSesion() && (request.auth.uid == uid || esAdmin());
      allow list: if esAdmin();
      allow create: if conSesion() && request.auth.uid == uid && request.resource.data.activo == true;
      // Cada quien edita su perfil, pero no puede rehabilitarse a sí mismo.
      allow update: if esAdmin()
        || (conSesion() && request.auth.uid == uid && request.resource.data.activo == resource.data.activo);
      allow delete: if esAdmin();
    }

    match /favoritos/{id} {
      // El administrador puede leerlos para las estadísticas.
      allow read: if esAdmin() || (conSesion() && (resource == null || resource.data.id_usuario == request.auth.uid));
      allow delete: if conSesion() && (resource == null || resource.data.id_usuario == request.auth.uid);
      allow create, update: if conSesion() && request.resource.data.id_usuario == request.auth.uid;
    }

    match /usuario_preferencias/{id} {
      allow read, delete: if conSesion() && (resource == null || resource.data.id_usuario == request.auth.uid);
      allow create, update: if conSesion() && request.resource.data.id_usuario == request.auth.uid;
    }

    // ---------- Sprint 3: viajes ----------
    function viajeValido() {
      let d = request.resource.data;
      return d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 80
        && d.paradas is list && d.paradas.size() <= 30
        && (!('notas' in d) || (d.notas is string && d.notas.size() <= 1000));
    }

    // Cada usuario solo ve, crea y modifica SUS viajes.
    match /viajes/{id} {
      allow read, delete: if conSesion() && resource.data.id_usuario == request.auth.uid;
      allow create: if conSesion() && request.resource.data.id_usuario == request.auth.uid && viajeValido();
      allow update: if conSesion() && resource.data.id_usuario == request.auth.uid
        && request.resource.data.id_usuario == resource.data.id_usuario && viajeValido();
    }

    // Copia de solo lectura de un viaje compartido. Se abre con el token del
    // enlace (get), pero nadie puede listar la colección para descubrir tokens.
    match /viajes_compartidos/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if conSesion() && token.size() >= 20 && request.resource.data.id_usuario == request.auth.uid;
      allow update, delete: if conSesion() && resource.data.id_usuario == request.auth.uid;
    }

    // ---------- Sprint 3: notificaciones ----------
    match /novedades/{id} {
      allow read: if conSesion();
      allow write: if esAdmin();
    }

    match /ajustes_notificaciones/{uid} {
      allow read, write: if conSesion() && request.auth.uid == uid;
    }

    // ---------- Sprint 3: reportes de información ----------
    // El id es "{usuario}_{tipo}_{elemento}": un reporte por persona y lugar.
    function reporteValido() {
      let d = request.resource.data;
      return d.id_usuario == request.auth.uid
        && d.estado == 'pendiente'
        && d.tipo_elemento in ['destino', 'restaurante', 'alojamiento', 'evento']
        && d.motivo in ['incorrecto', 'desactualizado', 'inapropiado', 'otro']
        && d.descripcion is string && d.descripcion.size() <= 500;
    }

    match /reportes/{id} {
      allow read: if esAdmin() || (conSesion() && (resource == null || resource.data.id_usuario == request.auth.uid));
      allow create: if conSesion() && reporteValido()
        && id == request.auth.uid + '_' + request.resource.data.tipo_elemento + '_' + request.resource.data.id_elemento;
      // El autor solo puede volver a reportar si el anterior ya se cerró.
      allow update: if esAdmin()
        || (conSesion() && resource.data.id_usuario == request.auth.uid
          && resource.data.estado in ['resuelto', 'descartado'] && reporteValido());
      allow delete: if esAdmin();
    }

    // ---------- Sprint 3: visitas (estadísticas) ----------
    // Cualquiera puede registrar una visita con estos tres campos; solo el
    // administrador puede leerlas.
    match /visitas/{id} {
      allow create: if request.resource.data.keys().hasOnly(['id_destino', 'id_usuario', 'fecha'])
        && request.resource.data.id_destino is string && request.resource.data.id_destino.size() <= 120
        && request.resource.data.fecha == request.time
        && (request.resource.data.id_usuario == null || (conSesion() && request.resource.data.id_usuario == request.auth.uid));
      allow read: if esAdmin();
      allow update, delete: if false;
    }

    // ---------- Administradores ----------
    // Cada persona solo puede consultar si SU correo es administrador.
    // Nadie agrega administradores desde la app: se crean en esta consola,
    // con el correo como ID del documento.
    match /administradores/{id} {
      allow read: if conSesion() && (resource.data.email == request.auth.token.email || esAdmin());
      allow write: if false;
    }
  }
}
